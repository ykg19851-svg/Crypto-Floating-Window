;==================================================
; 拖动窗口
;==================================================


OnMessage(
    0x201,
    拖动窗口
)



拖动窗口(wParam,lParam,msg,hwnd)
{

    global 正在拖动


    正在拖动 := true


    PostMessage(
        0xA1,
        2
    )


    SetTimer(
        () => 正在拖动 := false,
        -1000
    )

}





;==================================================
; 币名处理
;==================================================


处理币名(名称, 间隔)
{

    if (间隔 <= 0)
        return 名称



    部分 := StrSplit(
        名称,
        "/"
    )


    币名 := 部分[1]

    后缀 := "/" 部分[2]



    输出 := ""


    Loop Parse, 币名
    {

        输出 .= A_LoopField


        if (A_Index < StrLen(币名))
            输出 .= " "

    }


    return 输出 后缀

}





;==================================================
; 数据保存
;==================================================


价格记录 := Map()

链价格记录 := Map()

;==================================================
; Binance刷新
;==================================================


刷新价格()
{

    global 更新时间控件
    global 连接控件

    global 币种列表

    global 价格控件
    global 箭头控件
    global 涨跌控件

    global 价格记录

    global 显示24小时涨跌
    global 显示价格箭头

    global 正在拖动



    if 正在拖动
        return




    for 序号, 项目 in 币种列表
    {

        交易对 := 项目[1]

        小数位 := 项目[2]



        try
        {

            请求 := ComObject(
                "WinHttp.WinHttpRequest.5.1"
            )


            请求.SetTimeouts(
                1000,
                1000,
                1000,
                1000
            )


            请求.Open(
                "GET",
                "https://api.binance.com/api/v3/ticker/24hr?symbol=" 交易对,
                true
            )


            请求.Send()

            请求.WaitForResponse()



            if (请求.Status != 200)
                continue



            数据 := 请求.ResponseText




            if RegExMatch(
                数据,
                '"lastPrice":"([^"]+)"',
                &价格结果
            )
            {


                更新时间 := FormatTime(
                    ,
"yyyy-MM-dd HH:mm"
                )


                更新时间控件.Text :=
                "Update：" 更新时间



                连接控件.Text := "Connected"

                连接控件.SetFont(
                    "c00FF00"
                )



                当前价格 := Number(
                    价格结果[1]
                )




                RegExMatch(
                    数据,
                    '"priceChangePercent":"([^"]+)"',
                    &涨跌结果
                )


                二十四小时涨跌 := Number(
                    涨跌结果[1]
                )




                显示价格 := Format(
                    "{:." 小数位 "f}",
                    当前价格
                )




                箭头 := ""

                颜色 := "FFFFFF"




                if 价格记录.Has(交易对)
                {

                    上次价格 := 价格记录[交易对]


                    if 显示价格箭头
                    {

                        if 当前价格 > 上次价格
                        {
                            箭头 := "▲"
                            颜色 := "00FF00"
                        }


                        else if 当前价格 < 上次价格
                        {
                            箭头 := "▼"
                            颜色 := "FF0000"
                        }

                    }

                }



                价格记录[交易对] := 当前价格





                涨跌文字 := ""

                涨跌颜色 := "FFFFFF"



                if 显示24小时涨跌
                {

                    涨跌文字 :=
                    Format(
                        "{:+.2f}",
                        二十四小时涨跌
                    ) . "%"



                    if 二十四小时涨跌 > 0
                    {
                        涨跌颜色 := "00FF00"
                    }


                    else if 二十四小时涨跌 < 0
                    {
                        涨跌颜色 := "FF0000"
                    }

                }





                价格控件[序号].Text :=
                显示价格


                箭头控件[序号].Text :=
                箭头


                涨跌控件[序号].Text :=
                涨跌文字





                价格控件[序号].SetFont(
                    "c" . 颜色
                )


                箭头控件[序号].SetFont(
                    "c" . 颜色
                )


                涨跌控件[序号].SetFont(
                    "c" . 涨跌颜色
                )

            }


        }
        catch
        {

            连接控件.Text := "Disconnected"


            连接控件.SetFont(
                "cFF0000"
            )

        }

    }

}







